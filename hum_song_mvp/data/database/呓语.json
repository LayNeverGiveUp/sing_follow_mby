      "vocal_end_source": "nominal_lrc_normal_duration"
    },
    {
      "index": 15,
      "start_time": 72.49,
      "end_time": 81.9,
      "text": "路还长 梦还多",
      "nominal_end_time": 81.9,
      "vocal_end_source": "nominal_lrc_normal_duration"
    },
    {
      "index": 16,
      "start_time": 81.9,
      "end_time": 84.02,
      "text": "被这话 欺骗的",
      "nominal_end_time": 84.02,
      "vocal_end_source": "nominal_lrc_normal_duration"
    },
    {
      "index": 17,
      "start_time": 84.02,
      "end_time": 89.12,
      "text": "何止你我",
      "nominal_end_time": 89.12,
      "vocal_end_source": "nominal_lrc_normal_duration"
    },
    {
      "index": 18,
      "start_time": 89.12,
      "end_time": 93.04,
      "text": "可是我现在依然不太会转弯",
      "nominal_end_time": 93.04,
      "vocal_end_source": "nominal_lrc_normal_duration"
    },
    {
      "index": 19,
      "start_time": 93.04,
      "end_time": 97.78,
      "text": "虽然孤单的人偶尔也想有个伴",
      "nominal_end_time": 97.78,
      "vocal_end_source": "nominal_lrc_normal_duration"
    },
    {
      "index": 20,
      "start_time": 97.78,
      "end_time": 100.83,
      "text": "冷风又吹的时候想说",
      "nominal_end_time": 100.83,
      "vocal_end_source": "nominal_lrc_normal_duration"
    },
    {
      "index": 21,
      "start_time": 100.83,
      "end_time": 106.74,
      "text": "这生活会不会有点难",
      "nominal_end_time": 106.74,
      "vocal_end_source": "nominal_lrc_normal_duration"
    },
    {
      "index": 22,
      "start_time": 106.74,
      "end_time": 110.53,
      "text": "难道是因为当初有话没讲完",
