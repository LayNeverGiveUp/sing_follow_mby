      "text": "结局不好看",
      "nominal_end_time": 33.28,
      "vocal_end_source": "nominal_lrc_fallback"
    },
    {
      "index": 5,
      "start_time": 33.28,
      "end_time": 37.4,
      "text": "人总需要记住遗憾",
