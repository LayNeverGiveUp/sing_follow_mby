    },
    {
      "index": 12,
      "start_time": 62.31,
      "end_time": 65.8,
      "text": "偶尔也心口一热",
      "nominal_end_time": 65.8,
      "vocal_end_source": "nominal_lrc_normal_duration"
    },
    {
      "index": 13,
      "start_time": 65.8,
      "end_time": 68.14,
      "text": "什么都不说",
